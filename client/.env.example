# Copie vers .env.local pour tests locaux en pointant vers une API distante (optionnel).
# En dev, sans variable : les appels passent par le proxy Vite → localhost:3001
# VITE_API_URL=http://localhost:3001

# Production (ex. après déploiement API sur Render) :
# VITE_API_URL=https://ton-api.onrender.com
